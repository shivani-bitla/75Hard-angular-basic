rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      // Signed-in users can read profiles (username search, friends' progress).
      allow read: if signedIn();
      allow write: if isUser(uid);

      // Anyone signed in can send a request as themselves; owner reads/deletes.
      match /friendRequests/{fromUid} {
        allow create: if isUser(fromUid);
        allow read, delete: if isUser(uid);
      }

      // Owner manages their list; the other party can add themselves (mutual add on accept).
      match /friends/{friendUid} {
        allow read: if signedIn();
        allow write: if isUser(uid) || isUser(friendUid);
      }
    }
  }
}
